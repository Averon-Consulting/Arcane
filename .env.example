# Local or managed Postgres. Not committed.
# Local Supabase (npx supabase start):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Django site. The lead pages require a sign-in.
# On Vercel, set DJANGO_DEBUG=0 and DJANGO_SECRET_KEY in the project env.
# DATABASE_URL there is the Supabase session string (port 5432) for Canada
# (Central), with sslmode=require. Montréal functions are pinned in vercel.json.
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

